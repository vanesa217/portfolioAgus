---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import FloatingCta from '../components/FloatingCta.astro';

interface Props {
  title?: string;
  description?: string;
  hideDefaultNav?: boolean;
}

const {
  title = "AgusLlama · Desarrollador Web Full Stack",
  description = "Desarrollo software web y e-commerce listos para escalar. Arquitectura limpia, experiencia de usuario y trato directo.",
  hideDefaultNav = false
} = Astro.props;
---

<!doctype html>
<html lang="es" class="scroll-smooth dark">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    
    <title>{title}</title>
    <meta name="description" content={description} />
    
    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta name="theme-color" content="#0B0F17" />
  </head>
  <body class="bg-[#0B0F17] text-white min-h-screen flex flex-col font-sans selection:bg-[#FF4D00]/30 selection:text-white relative overflow-x-hidden">
    
    <!-- Capa de Resplandores y Textura Unificada estilo Linear / Vercel -->
    <div class="fixed inset-0 pointer-events-none z-0 overflow-hidden">
      <!-- Resplandor ambiental sutil en el fondo del Hero (gradiente radial) -->
      <div class="absolute inset-x-0 top-0 h-[700px] bg-[radial-gradient(ellipse_80%_80%_at_50%_-20%,rgba(255,77,0,0.15),rgba(255,255,255,0))] pointer-events-none"></div>
      <!-- Textura sutil -->
      <div class="absolute inset-0 bg-quiet-dots opacity-40"></div>
    </div>

    <!-- Contenido Principal -->
    <div class="relative z-10 flex flex-col min-h-screen">
      {!hideDefaultNav && <Header />}
      <main class="flex-1 w-full">
        <slot />
      </main>
      {!hideDefaultNav && <Footer />}
      {!hideDefaultNav && <FloatingCta />}
    </div>

  </body>
</html>
