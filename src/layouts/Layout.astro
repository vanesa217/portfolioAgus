---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import FloatingCta from '../components/FloatingCta.astro';

interface Props {
  title?: string;
  description?: string;
  hideDefaultNav?: boolean;
}

const {
  title = "AgusLlama · Desarrollador Web Full Stack",
  description = "Desarrollo software web y e-commerce listos para escalar. Arquitectura limpia, experiencia de usuario y trato directo.",
  hideDefaultNav = false
} = Astro.props;
---

<!doctype html>
<html lang="es" class="scroll-smooth dark">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    
    <title>{title}</title>
    <meta name="description" content={description} />
    
    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta name="theme-color" content="#0A0E11" />
  </head>
  <body class="bg-[#0A0E11] text-white min-h-screen flex flex-col font-sans selection:bg-[#FF5722]/30 selection:text-white relative overflow-x-hidden">
    
    <!-- Capa de Resplandores y Textura Unificada (Sin cortes entre Header y Hero) -->
    <div class="fixed inset-0 pointer-events-none z-0 overflow-hidden">
      <!-- Resplandor Teal / Mint superior izquierdo que cubre Header y Hero -->
      <div class="absolute -top-24 -left-24 w-[450px] sm:w-[650px] h-[450px] sm:h-[650px] bg-teal-500/[0.12] rounded-full blur-[120px]"></div>
      <!-- Resplandor Cálido Fuego detrás de AgusLlama -->
      <div class="absolute top-28 left-1/4 w-[320px] sm:w-[450px] h-[320px] sm:h-[450px] bg-orange-600/[0.08] rounded-full blur-[100px]"></div>
      <!-- Resplandor Teal lateral derecho -->
      <div class="absolute top-28 -right-16 w-[400px] sm:w-[500px] h-[400px] sm:h-[500px] bg-teal-400/[0.08] rounded-full blur-[120px]"></div>
      <!-- Textura sutil -->
      <div class="absolute inset-0 bg-quiet-dots opacity-40"></div>
    </div>

    <!-- Contenido Principal -->
    <div class="relative z-10 flex flex-col min-h-screen">
      {!hideDefaultNav && <Header />}
      <main class="flex-1 w-full">
        <slot />
      </main>
      {!hideDefaultNav && <Footer />}
      {!hideDefaultNav && <FloatingCta />}
    </div>

  </body>
</html>
