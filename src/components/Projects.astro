---
import { projects } from '../data/projects';

interface Props {
  email?: string;
}

const { email = "agusllama1@gmail.com" } = Astro.props;
---

<section id="proyectos" class="w-full py-14 sm:py-20 md:py-24 bg-apple-bg border-t border-black/[0.06] relative">
  <div class="max-w-6xl mx-auto px-4 sm:px-6">
    <!-- Header de la sección -->
    <div class="max-w-2xl mb-10 sm:mb-14">
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-white border border-black/[0.08] text-apple-text-secondary text-[11px] sm:text-xs font-bold tracking-widest uppercase mb-3.5 shadow-xs">
        <span class="w-1.5 h-1.5 rounded-full bg-apple-green"></span>
        <span>CASOS DE ÉXITO & RESULTADOS REALES</span>
      </div>
      <h2 class="text-2xl sm:text-3xl md:text-4xl font-extrabold text-apple-text-primary tracking-tight mt-1 mb-3 text-balance">
        Proyectos diseñados para generar resultados medibles
      </h2>
      <p class="text-sm sm:text-base text-apple-text-secondary leading-relaxed text-pretty">
        Soluciones prácticas para automatizar procesos manuales y abrir canales de venta digitales que funcionen sin interrupciones.
      </p>
    </div>

    <!-- Grilla de Tarjetas de Proyecto (Apple Bento Cards) -->
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-6 sm:gap-8">
      {projects.map((project) => (
        <article class="bento-card p-6 sm:p-8 flex flex-col justify-between group">
          <div>
            <!-- Banner de Métrica de Alto Impacto (Apple Highlight Banner) -->
            <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-2 p-3.5 sm:p-4 mb-5 rounded-2xl bg-apple-green-light border border-emerald-500/20">
              <span class="text-[11px] sm:text-xs font-bold uppercase tracking-wider text-apple-text-secondary">
                {project.category}
              </span>
              <div class="flex items-center gap-1.5 text-emerald-700 font-extrabold text-xs sm:text-sm md:text-base">
                <svg class="w-4 h-4 shrink-0" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M13 7h8m0 0v8m0-8l-8 8-4-4-6 6" />
                </svg>
                <span>{project.impactMetric}</span>
              </div>
            </div>

            <!-- Título del Proyecto -->
            <h3 class="text-xl sm:text-2xl font-bold text-apple-text-primary tracking-tight mb-2.5 sm:mb-3">
              {project.title}
            </h3>

            <!-- Descripción de Impacto Comercial -->
            <p class="text-sm sm:text-base text-apple-text-secondary leading-relaxed mb-5 sm:mb-6 text-pretty">
              {project.description}
            </p>

            <!-- Lista de Beneficios para el Negocio -->
            <div class="mb-5 sm:mb-6 bg-[#F8F9FB] border border-black/[0.05] rounded-2xl p-4 sm:p-5">
              <h4 class="text-[11px] sm:text-xs font-bold uppercase tracking-wider text-apple-text-primary mb-3">
                Mejoras implementadas para el cliente:
              </h4>
              <ul class="space-y-2.5">
                {project.businessHighlights.map((highlight) => (
                  <li class="flex items-start gap-2.5 text-xs sm:text-sm text-apple-text-primary leading-normal">
                    <svg class="w-4 h-4 text-apple-green shrink-0 mt-0.5" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" />
                    </svg>
                    <span>{highlight}</span>
                  </li>
                ))}
              </ul>
            </div>
          </div>

          <div>
            <!-- Etiquetas de Tecnologías (Apple Pill Tags) -->
            <div class="flex flex-wrap items-center gap-2 pt-4 pb-5 sm:pb-6 border-t border-black/[0.05]">
              <span class="text-xs font-semibold text-apple-text-tertiary mr-1">Herramientas:</span>
              {project.techTags.map((tech) => (
                <span class="text-xs font-medium bg-white text-apple-text-secondary px-3 py-1 rounded-full border border-black/[0.06] shadow-2xs">
                  {tech}
                </span>
              ))}
            </div>

            <!-- Acción Directa: Conversión con touch target min-h-[48px] -->
            <div class="pt-1">
              <a 
                href={`mailto:${email}?subject=${encodeURIComponent(project.inquirySubject)}&body=${encodeURIComponent(`Hola Agustín, vi el caso de "${project.title}" y me gustaría consultar sobre una solución similar para mi negocio.`)}`}
                class="bento-btn-secondary min-h-[48px] w-full text-center text-xs sm:text-sm font-semibold !py-3 hover:bg-brand-primary hover:!text-white hover:border-transparent transition-all justify-center active:scale-[0.98]"
              >
                <span>Consultar por un proyecto similar</span>
                <svg class="w-4 h-4 ml-1 shrink-0" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M14 5l7 7m0 0l-7 7m7-7H3" />
                </svg>
              </a>
            </div>
          </div>
        </article>
      ))}
    </div>
  </div>
</section>
