---
// Projects.astro - Proyectos destacados en estética Quiet Luxury / Editorial Tech
import { projects } from '../data/projects';

interface Props {
  email?: string;
}

const { email = "agusllama1@gmail.com" } = Astro.props;
---

<section id="proyectos" class="w-full py-14 sm:py-20 border-b border-white/[0.06] relative">
  <div class="max-w-6xl mx-auto px-4 sm:px-6 relative z-10">
    
    <!-- Header de la sección de Proyectos: Tipografía blanca y limpia -->
    <div class="max-w-2xl mb-10 sm:mb-14">
      <div class="inline-flex items-center gap-2 px-2.5 py-1 rounded-full bg-white/[0.04] border border-white/[0.08] text-slate-400 text-xs font-mono mb-3">
        <span>TRABAJOS RECIENTES</span>
      </div>
      <h2 class="text-2xl sm:text-3xl md:text-4xl font-extrabold text-white tracking-tight mt-1 mb-2 text-balance">
        Proyectos destacados
      </h2>
      <p class="text-sm sm:text-base text-slate-400 leading-relaxed text-pretty">
        Una selección de plataformas web, sistemas de gestión y e-commerce construidos con arquitecturas limpias y alto rendimiento.
      </p>
    </div>

    <!-- Grilla de Tarjetas de Proyecto (Quiet Cards) -->
    <div class="grid grid-cols-1 lg:grid-cols-3 gap-5 sm:gap-6">
      {projects.map((project) => (
        <article class="quiet-card p-5 sm:p-6 flex flex-col justify-between group">
          <div>
            <!-- Header de la Card -->
            <div class="flex items-center justify-between gap-2 pb-3 mb-3.5 border-b border-white/[0.06]">
              <span class="text-[11px] font-mono font-medium text-slate-300 bg-white/[0.04] px-2 py-0.5 rounded border border-white/[0.06]">
                {project.category}
              </span>
              <span class="text-[10px] font-mono text-emerald-400/90">
                PROD
              </span>
            </div>

            <!-- Título del Proyecto -->
            <h3 class="text-base sm:text-lg font-bold text-white tracking-tight mb-2 group-hover:text-sky-300 transition-colors">
              {project.title}
            </h3>

            <!-- Descripción -->
            <p class="text-xs sm:text-sm text-slate-400 leading-relaxed mb-4 text-pretty">
              {project.description}
            </p>

            <!-- Puntos Clave de la Solución -->
            <div class="mb-4 bg-black/30 border border-white/[0.05] rounded-xl p-3">
              <h4 class="text-[10px] font-mono font-semibold uppercase tracking-wider text-slate-400 mb-2">
                Funcionalidades:
              </h4>
              <ul class="space-y-1.5">
                {project.businessHighlights.map((highlight) => (
                  <li class="flex items-start gap-2 text-xs text-slate-300 leading-normal">
                    <span class="text-slate-400 font-bold shrink-0">✓</span>
                    <span>{highlight}</span>
                  </li>
                ))}
              </ul>
            </div>
          </div>

          <div>
            <!-- Etiquetas de Tecnologías -->
            <div class="flex flex-wrap items-center gap-1.5 pt-3 pb-4 border-t border-white/[0.06]">
              {project.techTags.map((tech) => (
                <span class="text-[11px] font-mono text-slate-400 bg-white/[0.03] px-2 py-0.5 rounded border border-white/[0.05]">
                  {tech}
                </span>
              ))}
            </div>

            <!-- Acción Directa -->
            <a 
              href={`mailto:${email}?subject=${encodeURIComponent(project.inquirySubject)}&body=${encodeURIComponent(`Hola Agustín, vi tu proyecto "${project.title}" en tu portfolio y me gustaría conversar sobre algo similar.`)}`}
              class="btn-subtle-link !w-full !min-h-[40px] text-xs justify-center hover:!border-white/25 hover:!text-white"
            >
              <span>Consultar sobre este proyecto</span>
              <svg class="w-3.5 h-3.5 ml-1 shrink-0 text-slate-400" fill="none" stroke="currentColor" stroke-width="1.75" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" d="M14 5l7 7m0 0l-7 7m7-7H3" />
              </svg>
            </a>
          </div>
        </article>
      ))}
    </div>

  </div>
</section>
