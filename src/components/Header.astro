---
interface Props {
  ctaText?: string;
}

const { ctaText = "Cotizar un proyecto" } = Astro.props;
---

<header class="sticky top-0 z-50 w-full bg-[#F5F5F7]/85 backdrop-blur-xl border-b border-black/[0.06] transition-all">
  <div class="max-w-6xl mx-auto px-4 sm:px-6 h-16 flex items-center justify-between">
    <!-- Brand / Name con Badge unificado (#4F46E5) -->
    <a href="#" class="flex items-center gap-2.5 group shrink-0 text-decoration-none">
      <div class="w-8 h-8 sm:w-9 sm:h-9 rounded-xl bg-brand-primary text-white flex items-center justify-center font-bold text-xs sm:text-sm shadow-xs shrink-0 tracking-tight">
        AL
      </div>
      <div class="flex flex-col">
        <span class="text-sm font-bold text-apple-text-primary tracking-tight leading-tight group-hover:text-brand-primary transition-colors">
          Agustín Llama
        </span>
        <span class="hidden sm:block text-[11px] text-apple-text-secondary leading-tight font-medium">
          Desarrollador Full Stack
        </span>
      </div>
    </a>

    <!-- Desktop Navigation links -->
    <nav class="hidden md:flex items-center gap-7 text-sm font-medium text-apple-text-secondary">
      <a href="#soluciones" class="hover:text-apple-text-primary transition-colors py-2">Soluciones</a>
      <a href="#proyectos" class="hover:text-apple-text-primary transition-colors py-2">Casos de éxito</a>
      <a href="#sobre-mi" class="hover:text-apple-text-primary transition-colors py-2">Sobre mí</a>
    </nav>

    <!-- Header Action Button (Apple Pill Outline) -->
    <div class="flex items-center shrink-0">
      <a 
        href="mailto:agusllama1@gmail.com?subject=Cotizaci%C3%B3n%20de%20proyecto%20web" 
        class="bento-btn-ghost !whitespace-nowrap !py-2 !px-4 text-xs sm:text-sm font-semibold shadow-xs"
      >
        <svg class="w-3.5 h-3.5 mr-1.5 shrink-0 text-apple-text-secondary" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/>
        </svg>
        <span class="inline sm:hidden">Cotizar</span>
        <span class="hidden sm:inline">{ctaText}</span>
      </a>
    </div>
  </div>
</header>
