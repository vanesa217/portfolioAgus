---
// Header.astro - Barra Superior 100% Integrada (Sin bordes, sin cortes de color, sin botón)
const navItems = [
  {
    name: "Proyectos",
    href: "#proyectos"
  },
  {
    name: "Habilidades",
    href: "#habilidades"
  },
  {
    name: "Sobre mí",
    href: "#sobre-mi"
  },
  {
    name: "Contacto",
    href: "#contacto"
  }
];
---

<!-- HEADER SUPERIOR (Totalmente transparente y sin bordes) -->
<header id="main-header" class="sticky top-0 z-40 w-full bg-transparent border-none transition-all duration-300">
  <div class="max-w-6xl mx-auto h-16 sm:h-20 px-4 sm:px-6 lg:px-8 flex items-center justify-between">
    
    <!-- A la izquierda: Isotipo "AL" + AgusLlama + Full Stack Developer -->
    <a href="#" class="flex items-center gap-2.5 sm:gap-3 group shrink-0 text-decoration-none active:scale-[0.97] transition-transform">
      <div class="w-8 h-8 rounded-full bg-[#121A1F] text-white border border-[#FF5722]/40 flex items-center justify-center font-mono font-bold text-xs shrink-0 shadow-[0_0_10px_rgba(255,87,34,0.25)] transition-transform group-hover:scale-105">
        <span class="text-white">A</span><span class="text-[#FF5722]">L</span>
      </div>
      <div class="flex flex-col">
        <span class="text-xs sm:text-sm font-black text-white tracking-tight leading-tight flex items-center gap-1.5">
          <span>AgusLlama</span>
          <span class="w-1.5 h-1.5 rounded-full bg-[#FF5722] shadow-[0_0_6px_#FF5722]"></span>
        </span>
        <span class="text-[9.5px] sm:text-[10px] text-slate-400 font-mono leading-tight">
          Full Stack Developer
        </span>
      </div>
    </a>

    <!-- A la derecha (Desktop lg:): Links de navegación -->
    <nav class="hidden lg:flex items-center gap-8 text-xs sm:text-sm font-medium text-slate-300">
      {navItems.map((item) => (
        <a 
          href={item.href} 
          class="hover:text-white transition-colors duration-150 py-1"
        >
          {item.name}
        </a>
      ))}
    </nav>

  </div>
</header>

<script>
  // Transición suave: 100% transparente en el Hero, sutil cristal al scrollear
  function setupHeaderScroll() {
    const header = document.getElementById('main-header');
    if (!header) return;

    function onScroll() {
      if (window.scrollY > 40) {
        header?.classList.add('bg-[#0A0E11]/85', 'backdrop-blur-md');
      } else {
        header?.classList.remove('bg-[#0A0E11]/85', 'backdrop-blur-md');
      }
    }

    window.addEventListener('scroll', onScroll, { passive: true });
    onScroll();
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', setupHeaderScroll);
  } else {
    setupHeaderScroll();
  }
</script>
