---
// Solutions.astro - Habilidades y Servicios en estética Quiet Luxury
const services = [
  {
    title: "Plataformas Web & Interfaces",
    description: "Aplicaciones web de alto rendimiento, interactivas y totalmente responsivas. Diseñadas para que la experiencia sea instantánea en cualquier dispositivo.",
    tags: ["Astro", "React", "TypeScript", "Tailwind CSS"],
    icon: "M9.75 17L9 20l-1 1h8l-1-1-.75-3M3 13h18M5 17h14a2 2 0 002-2V5a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"
  },
  {
    title: "Sistemas de Gestión & Automatización",
    description: "Paneles internos, dashboards y automatizaciones que reemplazan planillas desordenadas por herramientas centralizadas con control de permisos y stock.",
    tags: ["Node.js", "Express", "PostgreSQL", "APIs REST"],
    icon: "M9 17V7m0 10a2 2 0 01-2 2H5a2 2 0 01-2-2V7a2 2 0 012-2h2a2 2 0 012 2m0 10a2 2 0 002 2h2a2 2 0 002-2M9 7a2 2 0 012-2h2a2 2 0 012 2m0 10V7m0 10a2 2 0 002 2h2a2 2 0 002-2V7a2 2 0 00-2-2h-2a2 2 0 00-2 2"
  },
  {
    title: "E-commerce Escalable & Pasarelas",
    description: "Tiendas online robustas con pasarelas de pago integradas, sincronización de pedidos y catálogos optimizados para maximizar la conversión.",
    tags: ["Checkout", "Pasarelas Online", "Catálogos", "Escalabilidad"],
    icon: "M16 11V7a4 4 0 00-8 0v4M5 9h14l1 12H4L5 9z"
  },
  {
    title: "Rendimiento, SEO & Accesibilidad",
    description: "Optimización técnica meticulosa para lograr puntuaciones perfectas en Google Lighthouse, Core Web Vitals en verde y posicionamiento orgánico.",
    tags: ["Lighthouse 100", "Core Web Vitals", "WCAG", "SEO"],
    icon: "M13 10V3L4 14h7v7l9-11h-7z"
  }
];

const techStack = [
  { category: "Frontend", items: ["Astro", "React", "TypeScript", "JavaScript", "Tailwind CSS", "HTML5 & CSS3"] },
  { category: "Backend & Datos", items: ["Node.js", "Express", "PostgreSQL", "Bases de datos SQL/NoSQL", "APIs REST"] },
  { category: "Cloud & DevTools", items: ["Git & GitHub", "Vite", "Cloudflare", "Vercel / Netlify", "Docker basics"] }
];
---

<section id="habilidades" class="w-full py-14 sm:py-20 border-b border-white/[0.06] relative">
  <div class="max-w-6xl mx-auto px-4 sm:px-6 relative z-10">
    
    <!-- Header de Habilidades -->
    <div class="max-w-2xl mb-10 sm:mb-14">
      <div class="inline-flex items-center gap-2 px-2.5 py-1 rounded-full bg-white/[0.04] border border-white/[0.08] text-slate-400 text-xs font-mono mb-3">
        <span>HABILIDADES & SERVICIOS</span>
      </div>
      <h2 class="text-2xl sm:text-3xl md:text-4xl font-extrabold text-white tracking-tight mt-1 mb-2 text-balance">
        Qué puedo construir para tu proyecto
      </h2>
      <p class="text-sm sm:text-base text-slate-400 leading-relaxed text-pretty">
        Combino diseño de interfaz, arquitectura de backend e ingeniería de rendimiento para entregar software listo para producción.
      </p>
    </div>

    <!-- Grilla de 4 Servicios/Habilidades Quiet Cards -->
    <div class="grid grid-cols-1 md:grid-cols-2 gap-4 sm:gap-5 mb-10">
      {services.map((item) => (
        <div class="quiet-card p-5 sm:p-6 flex flex-col justify-between group">
          <div>
            <!-- Icono + Título -->
            <div class="flex items-center gap-3 mb-3">
              <div class="w-9 h-9 rounded-lg bg-white/[0.04] border border-white/[0.06] text-slate-300 flex items-center justify-center shrink-0">
                <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="1.75" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" d={item.icon} />
                </svg>
              </div>
              <h3 class="text-base font-semibold text-white tracking-tight group-hover:text-sky-300 transition-colors">
                {item.title}
              </h3>
            </div>

            <p class="text-xs sm:text-sm text-slate-400 leading-relaxed mb-4 text-pretty">
              {item.description}
            </p>
          </div>

          <!-- Tags -->
          <div class="flex flex-wrap gap-1.5 pt-3 border-t border-white/[0.06]">
            {item.tags.map((tag) => (
              <span class="text-[11px] font-mono text-slate-300 bg-white/[0.03] px-2 py-0.5 rounded border border-white/[0.05]">
                {tag}
              </span>
            ))}
          </div>
        </div>
      ))}
    </div>

    <!-- Stack Tecnológico Organizado -->
    <div class="quiet-card p-5 sm:p-6">
      <h3 class="text-xs font-mono font-semibold uppercase tracking-wider text-slate-400 mb-4">
        Stack tecnológico y herramientas principales
      </h3>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-3">
        {techStack.map((group) => (
          <div class="p-3.5 rounded-xl bg-black/25 border border-white/[0.05]">
            <h4 class="text-xs font-mono font-medium text-slate-300 mb-2">
              {group.category}
            </h4>
            <div class="flex flex-wrap gap-1.5">
              {group.items.map((tech) => (
                <span class="text-[11px] font-mono text-slate-400 bg-white/[0.03] px-2 py-0.5 rounded border border-white/[0.04]">
                  {tech}
                </span>
              ))}
            </div>
          </div>
        ))}
      </div>
    </div>

  </div>
</section>
