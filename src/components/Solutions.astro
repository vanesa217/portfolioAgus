---
// Solutions.astro - Habilidades y Servicios en estética Linear / Vercel
const services = [
  {
    title: "Plataformas Web & Interfaces",
    description: "Aplicaciones web de alto rendimiento, interactivas y totalmente responsivas. Diseñadas para que la experiencia sea instantánea y atractiva en cualquier dispositivo.",
    tags: ["Astro", "React", "TypeScript", "Tailwind CSS"],
    icon: "M9.75 17L9 20l-1 1h8l-1-1-.75-3M3 13h18M5 17h14a2 2 0 002-2V5a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"
  },
  {
    title: "Sistemas de Gestión & Automatización",
    description: "Paneles internos, dashboards y automatizaciones que reemplazan planillas desordenadas por herramientas centralizadas con control de permisos y stock.",
    tags: ["Node.js", "Express", "PostgreSQL", "APIs REST"],
    icon: "M9 17V7m0 10a2 2 0 01-2 2H5a2 2 0 01-2-2V7a2 2 0 012-2h2a2 2 0 012 2m0 10a2 2 0 002 2h2a2 2 0 002-2M9 7a2 2 0 012-2h2a2 2 0 012 2m0 10V7m0 10a2 2 0 002 2h2a2 2 0 002-2V7a2 2 0 00-2-2h-2a2 2 0 00-2 2"
  },
  {
    title: "E-commerce Escalable & Pasarelas",
    description: "Tiendas online robustas con pasarelas de cobro online integradas, sincronización de pedidos y catálogos optimizados para maximizar la conversión.",
    tags: ["Checkout", "Pasarelas Online", "Catálogos", "Escalabilidad"],
    icon: "M16 11V7a4 4 0 00-8 0v4M5 9h14l1 12H4L5 9z"
  },
  {
    title: "Rendimiento, SEO & Accesibilidad",
    description: "Optimización técnica meticulosa para lograr puntuaciones perfectas en Google Lighthouse, Core Web Vitals en verde y posicionamiento orgánico.",
    tags: ["Lighthouse 100", "Core Web Vitals", "WCAG", "SEO"],
    icon: "M13 10V3L4 14h7v7l9-11h-7z"
  }
];

const techStack = [
  { category: "Frontend", items: ["Astro", "React", "TypeScript", "JavaScript", "Tailwind CSS", "HTML5 & CSS3"] },
  { category: "Backend & Datos", items: ["Node.js", "Express", "PostgreSQL", "Bases de datos SQL/NoSQL", "APIs REST"] },
  { category: "Cloud & DevTools", items: ["Git & GitHub", "Vite", "Cloudflare", "Vercel / Netlify", "Docker basics"] }
];
---

<section id="habilidades" class="w-full py-14 sm:py-20 border-b border-white/[0.08] relative scroll-mt-16 bg-[#0B0F17]">
  <div class="max-w-6xl mx-auto px-4 sm:px-6 relative z-10">
    
    <!-- Header de Habilidades -->
    <div class="max-w-2xl mb-10 sm:mb-14">
      <div class="inline-flex items-center gap-2 px-3.5 py-1 rounded-full bg-white/[0.04] border border-white/[0.08] text-slate-300 text-xs font-mono font-medium mb-3 shadow-xs">
        <span class="w-1.5 h-1.5 rounded-full bg-[#FF4D00]"></span>
        <span>HABILIDADES & SERVICIOS</span>
      </div>
      <h2 class="text-2xl sm:text-3xl md:text-4xl font-black text-white tracking-tight mt-1 mb-2 text-balance">
        Qué puedo construir para tu proyecto
      </h2>
      <p class="text-sm sm:text-base text-slate-400 leading-relaxed text-pretty font-normal">
        Combino diseño de interfaz, arquitectura de backend e ingeniería de rendimiento para entregar software listo para producción.
      </p>
    </div>

    <!-- Grilla de 4 Servicios/Habilidades Quiet Cards con Spotlight, Scroll Reveal y feedback táctil -->
    <div class="grid grid-cols-1 md:grid-cols-2 gap-4 sm:gap-6 mb-10">
      {services.map((item) => (
        <div class="quiet-card spotlight-card scroll-reveal-item p-6 sm:p-7 flex flex-col justify-between group relative overflow-hidden active:scale-[0.97] transition-all duration-100 ease-out">
          <div class="absolute inset-x-0 top-0 h-[1px] bg-gradient-to-r from-transparent via-white/10 to-transparent pointer-events-none"></div>
          <div class="relative z-10">
            <!-- Icono + Título -->
            <div class="flex items-center gap-3.5 mb-3.5">
              <div class="w-10 h-10 rounded-2xl bg-slate-950/60 border border-white/10 text-slate-300 flex items-center justify-center shrink-0 shadow-xs group-hover:scale-105 group-hover:border-orange-500/40 group-hover:text-orange-400 transition-all duration-300">
                <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                  <path strokeLinecap="round" stroke-linejoin="round" d={item.icon} />
                </svg>
              </div>
              <h3 class="text-base sm:text-lg font-bold text-white tracking-tight group-hover:text-orange-400/90 transition-colors">
                {item.title}
              </h3>
            </div>

            <p class="text-xs sm:text-sm text-slate-400 leading-relaxed mb-5 text-pretty font-normal">
              {item.description}
            </p>
          </div>

          <!-- Tags de tecnologías con microinteracción suave -->
          <div class="flex flex-wrap gap-1.5 pt-4 border-t border-white/[0.08] relative z-10">
            {item.tags.map((tag) => (
              <span class="text-[11px] font-mono font-medium text-slate-300 bg-slate-950/60 border border-white/[0.08] px-2.5 py-1 rounded-md hover:-translate-y-0.5 hover:border-orange-500/40 hover:bg-white/[0.06] transition-all duration-200 cursor-default">
                {tag}
              </span>
            ))}
          </div>
        </div>
      ))}
    </div>

    <!-- Stack Tecnológico Organizado con Scroll Reveal -->
    <div class="quiet-card spotlight-card scroll-reveal-item p-6 sm:p-8 relative overflow-hidden">
      <div class="relative z-10">
        <h3 class="text-xs font-mono font-bold uppercase tracking-wider text-slate-300 mb-5 flex items-center gap-2">
          <span class="w-1.5 h-1.5 rounded-full bg-[#FF4D00]"></span>
          <span>Stack tecnológico y herramientas principales</span>
        </h3>

        <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
          {techStack.map((group) => (
            <div class="p-4 rounded-2xl bg-slate-950/50 border border-white/[0.08]">
              <h4 class="text-xs font-mono font-bold text-white mb-2.5 flex items-center gap-1.5">
                <span class="text-[#FF4D00]">✦</span>
                <span>{group.category}</span>
              </h4>
              <div class="flex flex-wrap gap-1.5">
                {group.items.map((tech) => (
                  <span class="text-[11px] font-mono font-medium text-slate-300 bg-white/[0.04] px-2.5 py-1 rounded-md border border-white/[0.06] shadow-xs hover:-translate-y-0.5 hover:border-orange-500/40 hover:bg-white/[0.06] transition-all duration-200 cursor-default">
                    {tech}
                  </span>
                ))}
              </div>
            </div>
          ))}
        </div>
      </div>
    </div>

  </div>
</section>

<script>
  // 1. Spotlight effect cursor follower
  function setupSpotlightCards() {
    const cards = document.querySelectorAll('#habilidades .spotlight-card');
    cards.forEach((card) => {
      (card as HTMLElement).addEventListener('mousemove', (e: MouseEvent) => {
        const rect = (card as HTMLElement).getBoundingClientRect();
        const x = e.clientX - rect.left;
        const y = e.clientY - rect.top;
        (card as HTMLElement).style.setProperty('--mouse-x', `${x}px`);
        (card as HTMLElement).style.setProperty('--mouse-y', `${y}px`);
      });
    });
  }

  // 2. Transición de entrada al entrar en viewport: opacity 0 -> 1, y: 16 -> 0, cubic-bezier(0.16, 1, 0.3, 1), 0.5s con stagger 0.08s
  function setupSolutionsScrollReveal() {
    const section = document.getElementById('habilidades');
    if (!section) return;

    const items = section.querySelectorAll('.scroll-reveal-item');
    if (!items.length) return;

    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            items.forEach((item, index) => {
              setTimeout(() => {
                item.classList.add('is-visible');
              }, index * 80);
            });
            observer.unobserve(entry.target);
          }
        });
      },
      { threshold: 0.12 }
    );

    observer.observe(section);
  }

  function initSolutions() {
    setupSpotlightCards();
    setupSolutionsScrollReveal();
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initSolutions);
  } else {
    initSolutions();
  }
</script>

<style>
  /* Animación de entrada por scroll */
  .scroll-reveal-item {
    opacity: 0;
    transform: translateY(16px);
    transition: opacity 0.5s cubic-bezier(0.16, 1, 0.3, 1), transform 0.5s cubic-bezier(0.16, 1, 0.3, 1);
    will-change: opacity, transform;
  }
  .scroll-reveal-item.is-visible {
    opacity: 1;
    transform: translateY(0);
  }

  /* Spotlight interactivo */
  .spotlight-card::before {
    content: '';
    position: absolute;
    inset: -1px;
    border-radius: inherit;
    background: radial-gradient(350px circle at var(--mouse-x, -999px) var(--mouse-y, -999px), rgba(255, 87, 34, 0.15), transparent 80%);
    opacity: 0;
    transition: opacity 0.3s;
    pointer-events-none;
    z-index: 0;
  }
  .spotlight-card:hover::before {
    opacity: 1;
  }
</style>
