---
// Footer.astro - Pie de página minimalista Dark Flame & Teal
interface Props {
  email?: string;
  linkedinUrl?: string;
}

const {
  email = "agusllama1@gmail.com",
  linkedinUrl = "https://www.linkedin.com/in/agustin-llama"
} = Astro.props;

const currentYear = new Date().getFullYear();
---

<footer class="w-full bg-[#0A0E11] border-t border-white/[0.08] py-10 sm:py-12 relative z-10">
  <div class="max-w-6xl mx-auto px-4 sm:px-6">
    <div class="flex flex-col md:flex-row items-center justify-between gap-6 text-center md:text-left">
      
      <!-- Brand & Título -->
      <div class="flex items-center gap-2.5">
        <div class="w-8 h-8 rounded-full bg-[#162026] text-white border border-[#FF5722]/40 flex items-center justify-center font-bold text-xs font-mono shrink-0 shadow-[0_0_8px_rgba(255,87,34,0.3)]">
          <span class="text-white">A</span><span class="text-[#FF5722]">L</span>
        </div>
        <div>
          <p class="text-xs sm:text-sm font-black text-white leading-tight flex items-center gap-1.5 justify-center md:justify-start">
            <span>Agustín Llama</span>
            <span class="w-1.5 h-1.5 rounded-full bg-[#FF5722]"></span>
          </p>
          <p class="text-[10.5px] font-mono text-slate-400 leading-tight mt-0.5">
            Full Stack Developer
          </p>
        </div>
      </div>

      <!-- Enlaces Rápidos -->
      <nav class="flex flex-wrap items-center justify-center gap-6 text-xs font-semibold text-slate-300">
        <a href="#proyectos" class="hover:text-white transition-colors">Proyectos</a>
        <a href="#habilidades" class="hover:text-white transition-colors">Habilidades</a>
        <a href="#sobre-mi" class="hover:text-white transition-colors">Sobre mí</a>
        <a href="#contacto" class="hover:text-white transition-colors">Contacto</a>
      </nav>

      <!-- Canales Directos -->
      <div class="flex items-center gap-2.5">
        <a 
          href={`mailto:${email}`} 
          class="w-9 h-9 rounded-xl border border-white/10 bg-[#162026] text-slate-300 hover:text-white hover:border-[#FF5722]/50 hover:bg-[#1C2830] transition-all flex items-center justify-center shadow-xs"
          title="Email"
          aria-label="Email"
        >
          <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24">
            <path strokeLinecap="round" stroke-linejoin="round" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/>
          </svg>
        </a>

        <a 
          href={linkedinUrl} 
          target="_blank" 
          rel="noopener noreferrer" 
          class="w-9 h-9 rounded-xl border border-white/10 bg-[#162026] text-slate-300 hover:text-white hover:border-[#FF5722]/50 hover:bg-[#1C2830] transition-all flex items-center justify-center shadow-xs"
          title="LinkedIn"
          aria-label="LinkedIn"
        >
          <svg class="w-4 h-4 fill-current" viewBox="0 0 24 24">
            <path d="M19 0h-14c-2.761 0-5 2.239-5 5v14c0 2.761 2.239 5 5 5h14c2.762 0 5-2.239 5-5v-14c0-2.761-2.738-5-5-5zm-11 19h-3v-11h3v11zm-1.5-12.268c-.966 0-1.75-.79-1.75-1.764s.784-1.764 1.75-1.764 1.75.79 1.75 1.764-.783 1.764-1.75 1.764zm13.5 12.268h-3v-5.604c0-3.368-4-3.113-4 0v5.604h-3v-11h3v1.765c1.396-2.586 7-2.777 7 2.476v6.759z"/>
          </svg>
        </a>
      </div>

    </div>

    <!-- Copyright -->
    <div class="mt-8 pt-5 border-t border-white/[0.08] text-center text-[10.5px] font-mono text-slate-500">
      <p>© {currentYear} Agustín Llama · Arquitectura limpia & Software de alto impacto.</p>
    </div>
  </div>
</footer>
