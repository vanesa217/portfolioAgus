---
// FloatingCta.astro - CTA Flotante Inteligente con Punto Naranja Fuego Luminoso (100% estático, solo brilla y se atenúa)
interface Props {
  text?: string;
  targetId?: string;
}

const { text = "Contactarme", targetId = "contacto" } = Astro.props;
---

<a 
  href={`#${targetId}`}
  id="floating-cta"
  class="fixed bottom-5 right-4 sm:bottom-6 sm:right-6 z-40 inline-flex items-center gap-2.5 px-4 py-2.5 rounded-full bg-[#11181C]/90 backdrop-blur-md border border-white/10 hover:border-[#FF5722]/60 text-xs font-bold text-white shadow-[0_8px_30px_-4px_rgba(0,0,0,0.6),0_0_20px_-3px_rgba(255,87,34,0.3)] hover:shadow-[0_12px_36px_-4px_rgba(0,0,0,0.8),0_0_28px_-2px_rgba(255,87,34,0.5)] transition-all duration-300 ease-out opacity-0 pointer-events-none translate-y-3 active:scale-95 select-none group"
  aria-label="Ir a la sección de contacto"
>
  <!-- Punto naranja 100% fijo (sin movimiento): solo brilla y se atenúa la luz -->
  <span class="relative flex h-2.5 w-2.5 items-center justify-center shrink-0">
    <!-- Onda de luz concéntrica que se expande y desvanece -->
    <span class="absolute inline-flex h-full w-full rounded-full bg-[#FF7043] animate-ping-glow"></span>
    <!-- Halo difuso que respira en intensidad de luz -->
    <span class="absolute inline-flex h-4 w-4 rounded-full bg-[#FF5722]/40 blur-[2px] animate-pulse-fade"></span>
    <!-- Núcleo naranja estático: brilla intensamente y se atenúa de forma fluida -->
    <span class="relative inline-flex h-2 w-2 rounded-full bg-[#FF5722] animate-core-glow shadow-[0_0_8px_#FF5722]"></span>
  </span>
  
  <!-- Texto 100% estático -->
  <span class="tracking-wide font-bold">{text}</span>
  
  <!-- Flecha 100% estática -->
  <span class="text-slate-400 group-hover:text-[#FF7043] font-black transition-colors">
    ↗
  </span>
</a>

<style>
  /* 1. Núcleo: Solo brilla y se atenúa (cero movimiento) */
  @keyframes coreGlow {
    0%, 100% {
      opacity: 1;
      box-shadow: 0 0 8px #FF5722, 0 0 16px rgba(255, 87, 34, 0.7);
    }
    50% {
      opacity: 0.35;
      box-shadow: 0 0 2px #FF5722, 0 0 4px rgba(255, 87, 34, 0.2);
    }
  }

  /* 2. Halo difuso: varía su opacidad luminosa */
  @keyframes pulseFade {
    0%, 100% {
      opacity: 0.25;
    }
    50% {
      opacity: 0.7;
    }
  }

  /* 3. Onda de luz expansiva concéntrica */
  @keyframes pingGlow {
    0% {
      transform: scale(0.9);
      opacity: 0.85;
    }
    70%, 100% {
      transform: scale(2.2);
      opacity: 0;
    }
  }

  .animate-core-glow {
    animation: coreGlow 2.2s ease-in-out infinite;
  }

  .animate-pulse-fade {
    animation: pulseFade 2.2s ease-in-out infinite;
  }

  .animate-ping-glow {
    animation: pingGlow 2.2s cubic-bezier(0, 0, 0.2, 1) infinite;
  }
</style>

<script>
  function setupFloatingCta() {
    const cta = document.getElementById('floating-cta');
    const heroSection = document.querySelector('section');
    const contactSection = document.getElementById('contacto');

    if (!cta) return;

    let isPastHero = false;
    let isInContact = false;

    function updateVisibility() {
      if (isPastHero && !isInContact) {
        cta?.classList.remove('opacity-0', 'pointer-events-none', 'translate-y-3');
        cta?.classList.add('opacity-100', 'pointer-events-auto', 'translate-y-0');
      } else {
        cta?.classList.remove('opacity-100', 'pointer-events-auto', 'translate-y-0');
        cta?.classList.add('opacity-0', 'pointer-events-none', 'translate-y-3');
      }
    }

    // 1. Observer para detectar cuándo se supera el Hero
    if (heroSection) {
      const heroObserver = new IntersectionObserver(
        (entries) => {
          entries.forEach((entry) => {
            isPastHero = !entry.isIntersecting;
            updateVisibility();
          });
        },
        { threshold: 0.15 }
      );
      heroObserver.observe(heroSection);
    }

    // 2. Observer para detectar si el usuario llegó a la sección #contacto
    if (contactSection) {
      const contactObserver = new IntersectionObserver(
        (entries) => {
          isInContact = entry.isIntersecting;
          updateVisibility();
        },
        { threshold: 0.1 }
      );
      contactObserver.observe(contactSection);
    }

    // 3. Smooth scroll al hacer clic
    cta.addEventListener('click', (e) => {
      const target = document.getElementById('contacto');
      if (target) {
        e.preventDefault();
        target.scrollIntoView({ behavior: 'smooth' });
      }
    });
  }

  // Inicialización segura con soporte para navegaciones
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', setupFloatingCta);
  } else {
    setupFloatingCta();
  }
</script>
