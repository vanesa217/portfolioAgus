---
// Contact.astro - Sección de contacto simple y sobria Linear / Vercel con feedback de 3 estados
interface Props {
  email?: string;
  linkedinUrl?: string;
}

const {
  email = "agusllama1@gmail.com",
  linkedinUrl = "https://www.linkedin.com/in/agustin-llama"
} = Astro.props;
---

<section id="contacto" class="w-full py-14 sm:py-20 border-b border-white/[0.08] relative scroll-mt-16 bg-[#0B0F17]">
  <div class="max-w-4xl mx-auto px-4 sm:px-6 relative z-10">
    
    <!-- Header de Contacto -->
    <div class="text-center max-w-xl mx-auto mb-10 sm:mb-14">
      <div class="inline-flex items-center gap-2 px-3.5 py-1 rounded-full bg-white/[0.04] border border-white/[0.08] text-slate-300 text-xs font-mono font-medium mb-3 shadow-xs">
        <span class="w-1.5 h-1.5 rounded-full bg-[#FF4D00]"></span>
        <span>CONTACTO DIRECTO</span>
      </div>
      <h2 class="text-2xl sm:text-3xl md:text-4xl font-black text-white tracking-tight mt-1 mb-2 text-balance">
        ¿Tienes un proyecto en mente? Hablemos.
      </h2>
      <p class="text-sm sm:text-base text-slate-400 leading-relaxed text-pretty font-normal">
        Ya sea que busques crear una plataforma desde cero, renovar un sistema existente o sumar un desarrollador a tu equipo, escríbeme y lo conversamos.
      </p>
    </div>

    <!-- Grid de Contacto: Canales Directos + Formulario -->
    <div class="grid grid-cols-1 md:grid-cols-12 gap-5 sm:gap-7 items-start">
      
      <!-- Columna Izquierda: Canales Directos (5 cols) -->
      <div class="md:col-span-5 space-y-4">
        
        <!-- Tarjeta de Email Directo -->
        <div class="quiet-card spotlight-card p-6 relative overflow-hidden active:scale-[0.97] transition-all duration-100 ease-out">
          <div class="absolute inset-x-0 top-0 h-[1px] bg-gradient-to-r from-transparent via-white/10 to-transparent pointer-events-none"></div>
          <div class="relative z-10">
            <p class="text-[10.5px] font-mono uppercase tracking-wider text-slate-300 font-bold mb-1">Email Directo</p>
            <h3 class="text-sm font-bold text-white mb-1.5">Escríbeme un correo</h3>
            <p class="text-xs text-slate-400 mb-4 font-normal">
              Respondo personalmente a todas las consultas en menos de 24 horas.
            </p>
            <a 
              href={`mailto:${email}?subject=Contacto%20desde%20portfolio`} 
              class="btn-subtle-dark !w-full !min-h-[44px] text-xs font-mono font-bold justify-center active:scale-[0.97] transition-transform duration-100 ease-out"
            >
              <span>{email}</span>
            </a>
          </div>
        </div>

        <!-- Tarjeta de LinkedIn -->
        <div class="quiet-card spotlight-card p-6 relative overflow-hidden active:scale-[0.97] transition-all duration-100 ease-out">
          <div class="absolute inset-x-0 top-0 h-[1px] bg-gradient-to-r from-transparent via-white/10 to-transparent pointer-events-none"></div>
          <div class="relative z-10">
            <p class="text-[10.5px] font-mono uppercase tracking-wider text-slate-300 font-bold mb-1">Red Profesional</p>
            <h3 class="text-sm font-bold text-white mb-1.5">LinkedIn</h3>
            <p class="text-xs text-slate-400 mb-4 font-normal">
              Conectemos para charlar sobre proyectos o colaboraciones.
            </p>
            <a 
              href={linkedinUrl} 
              target="_blank" 
              rel="noopener noreferrer" 
              class="btn-subtle-dark !w-full !min-h-[44px] text-xs font-bold justify-center active:scale-[0.97] transition-transform duration-100 ease-out"
            >
              <span>Ver perfil en LinkedIn &rarr;</span>
            </a>
          </div>
        </div>

      </div>

      <!-- Columna Derecha: Formulario Refinado con 3 Estados (7 cols) -->
      <div class="md:col-span-7 quiet-card spotlight-card p-6 sm:p-8 relative overflow-hidden">
        <div class="absolute inset-x-0 top-0 h-[1px] bg-gradient-to-r from-transparent via-orange-500/40 to-transparent pointer-events-none"></div>
        <div class="relative z-10">
          <h3 class="text-base sm:text-lg font-black text-white mb-1">
            Envíame un mensaje directo
          </h3>
          <p class="text-xs text-slate-400 mb-5 font-normal">
            Cuéntame brevemente qué necesitas y te responderé a la brevedad.
          </p>

          <form id="portfolio-contact-form" class="space-y-4">
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
              <div>
                <label for="contact-name" class="block text-xs font-mono font-bold text-slate-300 uppercase tracking-wider mb-1.5">
                  Nombre
                </label>
                <input 
                  type="text" 
                  id="contact-name" 
                  name="name"
                  required 
                  placeholder="Tu nombre" 
                  autocomplete="name"
                  autocapitalize="words"
                  enterkeyhint="next"
                  class="w-full min-h-[48px] px-4 py-3 text-base bg-slate-950/60 border border-white/10 rounded-xl text-white placeholder-slate-500 focus:outline-none focus:border-orange-500/50 focus:ring-1 focus:ring-orange-500/30 transition-colors shadow-xs"
                />
              </div>

              <div>
                <label for="contact-email" class="block text-xs font-mono font-bold text-slate-300 uppercase tracking-wider mb-1.5">
                  Email
                </label>
                <input 
                  type="email" 
                  id="contact-email" 
                  name="email"
                  required 
                  placeholder="tu@email.com" 
                  autocomplete="email"
                  inputmode="email"
                  autocapitalize="none"
                  enterkeyhint="next"
                  class="w-full min-h-[48px] px-4 py-3 text-base bg-slate-950/60 border border-white/10 rounded-xl text-white placeholder-slate-500 focus:outline-none focus:border-orange-500/50 focus:ring-1 focus:ring-orange-500/30 transition-colors shadow-xs"
                />
              </div>
            </div>

            <div>
              <label for="contact-message" class="block text-xs font-mono font-bold text-slate-300 uppercase tracking-wider mb-1.5">
                Mensaje o idea del proyecto
              </label>
              <textarea 
                id="contact-message" 
                name="message"
                rows="4" 
                required
                placeholder="Hola Agustín, me gustaría conversar sobre..." 
                enterkeyhint="send"
                class="w-full px-4 py-3 text-base bg-slate-950/60 border border-white/10 rounded-xl text-white placeholder-slate-500 focus:outline-none focus:border-orange-500/50 focus:ring-1 focus:ring-orange-500/30 transition-colors resize-y shadow-xs"
              ></textarea>
            </div>

            <!-- Botón de Envío con 3 Estados (Reposo, Enviando, Éxito) y ergonomía táctil -->
            <div class="pt-2">
              <button 
                type="submit" 
                id="contact-submit-btn"
                class="btn-flame-primary !w-full !min-h-[48px] text-xs sm:text-sm justify-center cursor-pointer transition-all duration-300 select-none active:scale-[0.97] transition-transform duration-100 ease-out"
              >
                <!-- 1. Estado Reposo -->
                <span id="btn-state-idle" class="inline-flex items-center justify-center gap-2">
                  <span>Enviar mensaje</span>
                  <svg class="w-4 h-4 ml-0.5 shrink-0 text-white" fill="none" stroke="currentColor" stroke-width="2.4" viewBox="0 0 24 24">
                    <path strokeLinecap="round" strokeLinejoin="round" d="M14 5l7 7m0 0l-7 7m7-7H3"/>
                  </svg>
                </span>

                <!-- 2. Estado Enviando: Spinner animate-spin + Enviando... -->
                <span id="btn-state-sending" class="hidden items-center justify-center gap-2">
                  <svg class="animate-spin h-4 w-4 text-white" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24">
                    <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
                    <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
                  </svg>
                  <span>Enviando...</span>
                </span>

                <!-- 3. Estado Éxito: Fondo emerald-600 + ✓ Mensaje enviado con éxito -->
                <span id="btn-state-success" class="hidden items-center justify-center gap-2 text-white font-bold tracking-wide">
                  <span>✓ Mensaje enviado con éxito</span>
                </span>
              </button>
            </div>
          </form>
        </div>

      </div>

    </div>

  </div>
</section>

<script>
  // Gestión de los 3 estados del botón de envío del formulario
  function setupContactForm() {
    const form = document.getElementById('portfolio-contact-form') as HTMLFormElement;
    const submitBtn = document.getElementById('contact-submit-btn') as HTMLButtonElement;
    const stateIdle = document.getElementById('btn-state-idle');
    const stateSending = document.getElementById('btn-state-sending');
    const stateSuccess = document.getElementById('btn-state-success');

    if (!form || !submitBtn || !stateIdle || !stateSending || !stateSuccess) return;

    let resetTimer: number | undefined;

    function setBtnState(state: 'idle' | 'sending' | 'success') {
      if (state === 'idle') {
        submitBtn.disabled = false;
        submitBtn.classList.remove('!bg-emerald-600', '!border-emerald-500/50', '!shadow-[0_0_20px_rgba(16,185,129,0.4)]', 'pointer-events-none');
        submitBtn.classList.add('cursor-pointer');
        
        stateIdle.classList.remove('hidden');
        stateIdle.classList.add('inline-flex');
        
        stateSending.classList.add('hidden');
        stateSending.classList.remove('inline-flex');
        
        stateSuccess.classList.add('hidden');
        stateSuccess.classList.remove('inline-flex');
      } else if (state === 'sending') {
        submitBtn.disabled = true;
        submitBtn.classList.add('pointer-events-none');
        submitBtn.classList.remove('cursor-pointer');

        stateIdle.classList.add('hidden');
        stateIdle.classList.remove('inline-flex');

        stateSending.classList.remove('hidden');
        stateSending.classList.add('inline-flex');

        stateSuccess.classList.add('hidden');
        stateSuccess.classList.remove('inline-flex');
      } else if (state === 'success') {
        submitBtn.disabled = true;
        submitBtn.classList.add('!bg-emerald-600', '!border-emerald-500/50', '!shadow-[0_0_20px_rgba(16,185,129,0.4)]', 'pointer-events-none');
        submitBtn.classList.remove('cursor-pointer');

        stateIdle.classList.add('hidden');
        stateIdle.classList.remove('inline-flex');

        stateSending.classList.add('hidden');
        stateSending.classList.remove('inline-flex');

        stateSuccess.classList.remove('hidden');
        stateSuccess.classList.add('inline-flex');
      }
    }

    form.addEventListener('submit', (e) => {
      e.preventDefault();

      const nameInput = document.getElementById('contact-name') as HTMLInputElement;
      const emailInput = document.getElementById('contact-email') as HTMLInputElement;
      const messageInput = document.getElementById('contact-message') as HTMLTextAreaElement;

      const name = nameInput.value;
      const email = emailInput.value;
      const message = messageInput.value;

      // 1. Activar estado 'Enviando...'
      setBtnState('sending');

      // 2. Transición tras despacho a 'Éxito' durante 4 segundos
      setTimeout(() => {
        const subject = `Contacto desde Portfolio: ${name}`;
        const body = `Hola Agustín,\n\nMi nombre es ${name} (${email}).\n\nMensaje:\n${message}`;
        window.location.href = `mailto:agusllama1@gmail.com?subject=${encodeURIComponent(subject)}&body=${encodeURIComponent(body)}`;

        setBtnState('success');
        form.reset();

        // 3. Restaurar a estado 'Reposo' tras 4 segundos
        if (resetTimer) clearTimeout(resetTimer);
        resetTimer = window.setTimeout(() => {
          setBtnState('idle');
        }, 4000);
      }, 700);
    });
  }

  // Spotlight effect cursor follower para tarjetas de contacto
  function setupContactSpotlight() {
    const cards = document.querySelectorAll('#contacto .spotlight-card');
    cards.forEach((card) => {
      (card as HTMLElement).addEventListener('mousemove', (e: MouseEvent) => {
        const rect = (card as HTMLElement).getBoundingClientRect();
        const x = e.clientX - rect.left;
        const y = e.clientY - rect.top;
        (card as HTMLElement).style.setProperty('--mouse-x', `${x}px`);
        (card as HTMLElement).style.setProperty('--mouse-y', `${y}px`);
      });
    });
  }

  function initContact() {
    setupContactForm();
    setupContactSpotlight();
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initContact);
  } else {
    initContact();
  }
</script>

<style>
  .spotlight-card::before {
    content: '';
    position: absolute;
    inset: -1px;
    border-radius: inherit;
    background: radial-gradient(350px circle at var(--mouse-x, -999px) var(--mouse-y, -999px), rgba(255, 87, 34, 0.15), transparent 80%);
    opacity: 0;
    transition: opacity 0.3s;
    pointer-events-none;
    z-index: 0;
  }
  .spotlight-card:hover::before {
    opacity: 1;
  }
</style>
